# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://ctmcp:ctmcp_password@localhost:5432/clinical_trials

# Anthropic — used for the summarize_eligibility tool (Phase 2)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — used for embeddings (Anthropic's recommended embedding partner)
# Get one at https://www.voyageai.com/  (free tier covers a lot)
VOYAGE_API_KEY=pa-...

# Embedding model. voyage-3 is 1024-dim and strong on biomedical text.
EMBEDDING_MODEL=voyage-3

# Summarization model (Anthropic). Haiku 4.5 is fast and cheap;
# switch to claude-sonnet-4-6 for richer summaries.
SUMMARY_MODEL=claude-haiku-4-5-20251001

# Max trials to return from search_trials tool
SEARCH_TOP_K=10

# Ingest script defaults
DEFAULT_INGEST_QUERY=cancer
DEFAULT_INGEST_MAX=500

# --- ClinicalTrials.gov access ---------------------------------------------
# CT.gov is behind Akamai Bot Manager. We use curl_cffi to impersonate a
# browser TLS handshake. "chrome" tracks a recent Chrome; pin (e.g.
# "chrome124") if a future Akamai rule change breaks the default.
CTGOV_IMPERSONATE=chrome

# TLS verification for CT.gov requests. Leave true normally.
# If you are behind a TLS-intercepting proxy (corporate firewall / AV SSL
# scanning) libcurl can't verify the chain. Either:
#   (a) point CTGOV_CA_BUNDLE at your proxy's root CA PEM (preferred), or
#   (b) set CTGOV_SSL_VERIFY=false (only trusts your own proxy infra).
CTGOV_SSL_VERIFY=true
# CTGOV_CA_BUNDLE=C:\path\to\corporate-root-ca.pem
